# Python
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Secrets / local config
.env
.env.*
!.env.example
.claude/settings.local.json
# Claude Code agent worktrees — checkouts of this same repo, not content.
.claude/worktrees/
# Persisted UserConfig — holds hf_token in plaintext (app/config.py)
config-user.json
# Per-user UI state (server.py PREFS_FILE) — last-used models, voice,
# and the creator/pro mode choice. Local to one install, like the above.
user_prefs.json
# User's own glossary — names, brands and personal terms they corrected
# during review. Private to one creator; never in the repo.
presets/user_glossary.json
# Platform credentials store — VK token etc. (app/secrets.py)
secrets.json
# API keys (salted hashes) and webhook subscriptions incl. signing secrets.
# Same reasoning as secrets.json — never in the repo.
apikeys.json
webhooks.json
# Append-only audit trail (app/audit.py) — local runtime record.
audit.jsonl

# Server runtime artifacts
.gochidubb.pid
gochidubb.log
.coverage

# Runtime data
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep
jobs_db/*.json
!jobs_db/.gitkeep
gochidubb.db
gochidubb.db-journal
*.sqlite
*.sqlite-journal

# User-supplied reference voices (may be private)
presets/voices/*.wav
presets/voices/*.mp3
!presets/voices/.gitkeep

# Bundled binaries
bin/ffmpeg*
bin/ffprobe*
bin/yt-dlp*

# Local scratch — notes, sample media, exploratory scripts
product.txt
selfware.toml
# Downloaded source media lands at the repo root when a fetch is run by
# hand rather than through a job. Glob rather than naming files: yt-dlp
# names them after the video title, which is unpredictable.
*.webm
test_audio.wav
# Exploratory scripts, not pytest tests (see CLAUDE.md)
tests/manual_test_*.py
# Working copies of the UI kept alongside the real one
static/*copy*.html

# OS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/
*.swp
